{
  "name": "Zephyr Development",
  "image": "ghcr.io/royyandzakiy/zephyr-devcontainer-devel:z4.4.0-sdk1.0.1",

  // The extension host cannot read what use-vanilla exports in a shell, so the
  // active Zephyr and SDK have to be named here.
  "containerEnv": {
    "RUNNER_ALLOW_RUNASROOT": "1",
    "ZEPHYR_BASE": "/workdir/zephyr-sdks/v4.4.0/zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "/workdir/zephyr-sdks/toolchains/zephyr-sdk-1.0.1",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
    "ZSDK_TOOLCHAINS": "arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf",
    "ZEPHYR_BLOBS": "hal_espressif"
  },

  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--privileged"
  ],

  "mounts": [
    // Optional: host /dev, so USB debug probes are visible in the container.
    // On Windows, attach the probe to WSL with usbipd first.
    // "source=/dev,target=/dev,type=bind,bind-propagation=rslave",

    // Optional: keeps a GitHub Actions runner's registration across container rebuilds.
    // "source=${localWorkspaceFolderBasename}-actions-runner,target=/actions-runner,type=volume",

    // Shared by name across every project on the machine. The CMake package
    // registry is what the nRF Connect extension reads to find the SDKs.
    "source=zephyr-sdks,target=/workdir/zephyr-sdks,type=volume",
    "source=ncs-sdks,target=/workdir/ncs-sdks,type=volume",
    "source=cmake-registry,target=/root/.cmake,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "nordic-semiconductor.nrf-connect",
        "thecreativedodo.usbip-connect"
      ],
      "settings": {
        "nrf-connect.toolchainManager.installDirectory": "/workdir/ncs-sdks",
        "clangd.path": "/usr/bin/clangd",
        "clangd.checkUpdates": false
      }
    }
  },

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postStartCommand": "/opt/devcontainer/setup-sdks.sh"
}
