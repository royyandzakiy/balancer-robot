# Shared editor behaviour. clangd merges every .clangd from a file's folder up to here, nearer wins:
# firmware/.clangd and companion-app/.clangd hold the compile flags and diagnostics of each half.

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: No

Hover:
  ShowAKA: Yes

Completion:
  AllScopes: Yes
