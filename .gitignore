# companion-app/.gitignore covers the Qt/CMake side.

# Zephyr build output, including `-d` dirs like build_native64 and build_nrf5340dk.
# Anchored, since a bare build* would also ignore folders like docs/building/.
/build*/
firmware/**/build*/

# Twister output. Not twister*/, which would also ignore twister_harness/ or docs/twister/.
twister-out*/

# clangd background index
.cache/

# Python
**/.venv/
**/__pycache__/
**/.pytest_cache/

# Local only
.env
.claude/settings.local.json
.codebase-memory/
ANSWER.md
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini
